{
  "name": "@xia-sc/dsh-todo",
  "version": "0.1.4",
  "description": "便签墙式 TODO 清单：自由摆放的暖色便签、原地展开编辑、可选的工作区与起止时间与文档附件，以及默认关闭、按需加载给 LLM 的工具。",
  "license": "MIT",
  "author": "xia-sc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xia-sc/dsh-todo.git"
  },
  "homepage": "https://github.com/xia-sc/dsh-todo#readme",
  "bugs": {
    "url": "https://github.com/xia-sc/dsh-todo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "routes.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "todo",
    "sticky-notes"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": "^0.2.2-rc.5 || ^0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}



